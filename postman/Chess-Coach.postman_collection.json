{
  "info": {
    "name": "Chess Coach API",
    "_postman_id": "b1f4f3d8-8a7c-4b77-9b2c-4d38e3b42d10",
    "description": "Local API collection for authentication, Chess.com game sync, game retrieval, analysis lookup with real-time WebSocket updates, and puzzles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"},
    {"key": "wsUrl", "value": "ws://localhost:8080"},
    {"key": "email", "value": "user@example.com"},
    {"key": "password", "value": "change-me-123"},
    {"key": "chessComUsername", "value": "your-chess-com-username"},
    {"key": "gameId", "value": "170979798774"},
    {"key": "gameUrl", "value": "https://www.chess.com/game/live/170979798774"},
    {"key": "token", "value": ""}
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}",
          "options": {"raw": {"language": "json"}}
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.token) pm.collectionVariables.set('token', body.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}",
          "options": {"raw": {"language": "json"}}
        },
        "url": "{{baseUrl}}/auth/token"
      }
    },
    {
      "name": "Sync Chess.com games",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{chessComUsername}}\"}",
          "options": {"raw": {"language": "json"}}
        },
        "url": "{{baseUrl}}/games/sync"
      }
    },
    {
      "name": "List games",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": "{{baseUrl}}/games"
      }
    },
    {
      "name": "Get game by ID",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": "{{baseUrl}}/games/{{gameId}}"
      }
    },
    {
      "name": "Get game by Chess.com URL",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": "{{baseUrl}}/games/by-url?url={{gameUrl}}"
      }
    },
    {
      "name": "Get game analysis",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": "{{baseUrl}}/analysis/{{gameId}}"
      }
    },
    {
      "name": "Get analysis status",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": "{{baseUrl}}/analysis/{{gameId}}/status",
        "description": "Returns analysis job status with progress tracking. Use tier-based adaptive polling: FAST tier polls at 15s, 30s, 60s, 120s; DEEP tier polls at 30s, 60s, 120s, 240s. Response includes status (queued/running/completed/failed), progress (0-100), movesAnalyzed, and totalMoves."
      }
    },
    {
      "name": "Get move-by-move analysis",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": "{{baseUrl}}/analysis/{{gameId}}/moves",
        "description": "Returns detailed move-by-move analysis with move quality classification (brilliant, mistake, blunder, etc.), evaluations before/after each move, best moves, and principal variations. Chess.com-like analysis data for frontend display."
      }
    },
    {
      "name": "Get game analysis summary",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": "{{baseUrl}}/analysis/{{gameId}}/summary",
        "description": "Returns overall game analysis summary including accuracy percentage, move quality breakdown (best moves, mistakes, blunders), average centipawn loss, and phase-specific statistics (opening, middlegame, endgame)."
      }
    },
    {
      "name": "Queue fast game review",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"tier\":\"FAST\"}",
          "options": {"raw": {"language": "json"}}
        },
        "url": "{{baseUrl}}/analysis/{{gameId}}"
      }
    },
    {
      "name": "Queue deep game review",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"tier\":\"DEEP\"}",
          "options": {"raw": {"language": "json"}}
        },
        "url": "{{baseUrl}}/analysis/{{gameId}}"
      }
    },
    {
      "name": "WebSocket Analysis Updates",
      "request": {
        "method": "GET",
        "header": [
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "url": "ws://localhost:8080/ws/analysis/{{gameId}}?token={{token}}",
        "description": "Real-time WebSocket connection for analysis status updates. Connects to receive live progress updates when analysis is queued and completed. Message format: {\"gameId\":\"123\",\"status\":\"queued|completed\",\"progress\":10,\"timestamp\":1234567890}. Testing: Use browser console: const ws = new WebSocket('ws://localhost:8080/ws/analysis/{gameId}?token={token}'); ws.onmessage = (e) => console.log(JSON.parse(e.data));"
      }
    },
    {
      "name": "List puzzles",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": "{{baseUrl}}/puzzles"
      }
    }
  ]
}